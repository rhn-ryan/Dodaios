{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dodaios Knowledge Graph Schema",
  "version": "1.0.0",
  "description": "Machine-readable knowledge graph for Dodaios codebase",
  "node_types": {
    "module": {
      "description": "A logical module or subsystem",
      "required_fields": ["id", "type", "name", "path", "description", "confidence", "last_verified_commit"]
    },
    "symbol": {
      "description": "A class, function, or method",
      "required_fields": ["id", "type", "name", "path", "description", "confidence", "last_verified_commit"]
    },
    "interface": {
      "description": "An API, IPC, or event contract",
      "required_fields": ["id", "type", "name", "description", "confidence", "last_verified_commit"]
    },
    "data_model": {
      "description": "A database schema or data structure",
      "required_fields": ["id", "type", "name", "description", "confidence", "last_verified_commit"]
    },
    "external_dependency": {
      "description": "An external library or service",
      "required_fields": ["id", "type", "name", "description", "confidence", "last_verified_commit"]
    },
    "execution_path": {
      "description": "An end-to-end execution flow",
      "required_fields": ["id", "type", "name", "description", "confidence", "last_verified_commit"]
    }
  },
  "edge_types": [
    "imports",
    "calls",
    "instantiates",
    "inherits_from",
    "implements",
    "reads_from",
    "writes_to",
    "publishes_event",
    "subscribes_to",
    "invokes",
    "exposes_interface",
    "consumes_interface",
    "configures",
    "initializes",
    "shuts_down",
    "tests",
    "depends_on",
    "consumes_data",
    "produces_data"
  ],
  "confidence_levels": ["verified", "inferred", "unknown", "stale"],
  "required_node_fields": ["id", "type", "name", "path", "description", "confidence", "last_verified_commit", "last_verified_at"],
  "required_edge_fields": ["id", "source", "target", "type", "direction", "confidence", "last_verified_commit"]
}